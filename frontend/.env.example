# Copy this file to `.env.local` for local overrides.
# Only non-secret, build-time configuration belongs here.
# NEVER put API keys, tokens, or credentials in frontend env files.
#
# Data source mode. API mode is the default; the in-memory demonstration
# dataset is used only when this is explicitly `demo` (the shell then shows a
# visible "Demo mode" banner).
# VITE_DATA_MODE=api
#
# Base URL of the TicketFlow API. Optional: development defaults to
# http://127.0.0.1:8000/api/v1, production builds default to /api/v1 on the
# same origin. The frontend never stores credentials; sign-in uses the API.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
