# Copy this file to `.env.local` for local overrides.
# Only non-secret, build-time configuration belongs here.
# NEVER put API keys, tokens, or credentials in frontend env files.
#
# Base URL of the future TicketFlow API (Phase 2+).
# During Phase 1 the app uses an in-memory demonstration dataset
# (see src/services/demoTicketService.ts) and does not contact any backend.
VITE_API_BASE_URL=http://localhost:8080/api/v1
