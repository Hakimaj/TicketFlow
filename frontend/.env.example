# Copy this file to `.env.local` for local overrides.
# Only non-secret, build-time configuration belongs here.
# NEVER put API keys, tokens, or credentials in frontend env files.
#
# Base URL of the TicketFlow API (backend/, Phase 5).
# The frontend has NOT been switched over yet: it still uses the in-memory
# demonstration dataset (see src/services/demoTicketService.ts) and does not
# contact any backend. The backend runs on port 8000 by default.
VITE_API_BASE_URL=http://localhost:8000/api/v1
