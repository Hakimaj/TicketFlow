# TicketFlow full-stack Docker Compose configuration (root docker-compose.yml).
#
#   cp .env.example .env      # then edit the values below
#
# Every value here is a local development placeholder, never a credential, and
# `.env` is git-ignored. This file is only for `docker compose up`; local
# non-containerised backend development uses backend/.env.example instead.

# --- Database --------------------------------------------------------------
POSTGRES_DB=ticketflow
POSTGRES_USER=ticketflow
# Change this before exposing the stack anywhere.
POSTGRES_PASSWORD=change-me-local-development-only

# --- API ------------------------------------------------------------------
# development | test | production. `production` additionally requires
# COOKIE_SECURE=true and https:// CORS origins (validated at startup).
APP_ENV=development

# REQUIRED: at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters

# The browser origin that reaches the web container. Must match WEB_PORT.
# Comma-separated. "*" is rejected.
CORS_ORIGINS=http://localhost:8080

# Local HTTP evaluation keeps this false; every HTTPS deployment sets it true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Development-only demo accounts. Never enable with APP_ENV=production.
DEMO_ACCOUNTS_ENABLED=false

# --- Web ------------------------------------------------------------------
WEB_PORT=8080
