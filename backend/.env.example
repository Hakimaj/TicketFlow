# TicketFlow backend — local development configuration template.
#
# Copy to backend/.env (git-ignored) and adjust as needed:
#   cp .env.example .env
#
# All values below are local development placeholders, not secrets and not
# production credentials. Never commit a real `.env`.

# --- Application -----------------------------------------------------------
APP_ENV=development
# Comma-separated list of browser origins allowed by CORS.
# Restrict this to the frontend dev server; do not use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL (used by docker compose and the API) -----------------------
POSTGRES_DB=ticketflow
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=ticketflow_local_dev_only
POSTGRES_PORT=5432

# SQLAlchemy URL. The psycopg (v3) driver is used.
DATABASE_URL=postgresql+psycopg://ticketflow:ticketflow_local_dev_only@127.0.0.1:5432/ticketflow

# --- Authentication -------------------------------------------------------
# REQUIRED. At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# A missing or short secret fails the API at startup.
JWT_SECRET=replace-with-a-random-64-character-value-at-least-32-chars

# Access tokens are short-lived JWTs held in browser memory only.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh tokens are opaque random strings; only their SHA-256 hash is stored.
# They travel in an HttpOnly cookie scoped to /api/v1/auth.
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_COOKIE_NAME=ticketflow_refresh

# Cookie security. local HTTP development stays `false`; every HTTPS
# deployment must set COOKIE_SECURE=true. SameSite=none additionally
# requires a secure context.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Failed login back-off (process-local; see README limitations).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- First administrator bootstrap ----------------------------------------
# Used by `python scripts/bootstrap.py` only. Leave set for one run, then
# clear the password from the environment. Never commit real credentials.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Development demo accounts -------------------------------------------
# Creates the documented development sign-in accounts (dev only). Never
# enable in production. Password for the demo accounts comes from
# DEMO_ACCOUNT_PASSWORD (also never committed).
DEMO_ACCOUNTS_ENABLED=false
# DEMO_ACCOUNT_PASSWORD=

# --- Optional --------------------------------------------------------------
# Echo SQL statements to stdout (noisy; development only).
DATABASE_ECHO=false
